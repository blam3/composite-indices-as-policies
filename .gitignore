# --- Data: never commit. Raw ACS variance replicate tables are hundreds of MB
# and the CDC validation file is redistributable but large. data/README.md
# documents how to fetch them.
data/raw/*
!data/raw/.gitkeep
data/derived/*
!data/derived/.gitkeep
# The pipeline's own root is analysis/<state>/, so DIR_RAW is
# analysis/<state>/data/raw/140 -- the anchored patterns above do not
# reach it. These do.
**/data/raw/*
!**/data/raw/.gitkeep
**/data/derived/*
!**/data/derived/.gitkeep
# Pipeline scratch and rerun outputs (00_config.R DIR_WORK / DIR_OUT).
analysis/*/work/
analysis/*/outputs-rerun/
*.zip
*.tar.gz

# --- R
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
.Renviron
*.Rcheck/
*.tar.gz
*.tgz

# --- Editors / OS
.DS_Store
.vscode/
.idea/
*~
\#*\#

# --- Session scratch
scratch/
tmp/
*.log

# Python standard-library reproduction helpers
__pycache__/
*.py[cod]
